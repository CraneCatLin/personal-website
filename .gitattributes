# 统一换行符规范
# 所有源代码文件使用 LF 换行符
*.md   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.py   text eol=lf
*.ps1  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf

# 二进制文件不进行换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.svg  binary
*.webp binary
*.bmp  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary